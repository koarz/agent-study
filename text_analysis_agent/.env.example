# 将此文件复制为 text_analysis_agent 目录中的 .env，也可通过前端配置。
LLM_API_KEY=YOUR_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=YOUR_MODEL
LLM_TIMEOUT=120
# 回答随机性（temperature）：支持时可设为 0；不支持时留空，使用模型服务的默认设置。
LLM_TEMPERATURE=
# 自动请求 JSON 输出；接口明确不支持时回退。on 强制要求支持，off 仅用提示词约束。
LLM_JSON_MODE=auto

# 可选的独立复核模型。留空则复用回答模型的配置。
VERIFY_MODEL_ID=
VERIFY_BASE_URL=
VERIFY_API_KEY=

# 长篇小说推荐 hybrid 混合检索；lexical 为明确指定的关键词检索模式。
RETRIEVAL_MODE=hybrid
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL_ID=YOUR_EMBEDDING_MODEL
EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY
EMBEDDING_BASE_URL=https://YOUR_EMBEDDING_PROVIDER/v1
EMBEDDING_DIMENSIONS=
# Qwen3 等指令型嵌入模型可按模型说明设置查询前缀。
# 如需换行，请在带双引号的值中写入 \n；文档提供查询指令示例。
EMBEDDING_QUERY_PREFIX=

# 重排接口须返回 results 数组，以及每项的 index 和 relevance_score。
RERANK_PROVIDER=api
RERANK_MODEL_ID=YOUR_RERANK_MODEL
RERANK_API_KEY=YOUR_RERANK_API_KEY
RERANK_URL=https://YOUR_RERANK_PROVIDER/v1/rerank
# 本地开源重排：先在前端下载，再将 RERANK_PROVIDER 设为 local。
# API 模型配置单独保留，切回 api 时仍可使用。
LOCAL_RERANK_MODEL_ID=Qwen/Qwen3-Reranker-0.6B
# 本地覆盖全部召回候选，不使用 API 预算；每段最多评分 2 种当前问题表述。
LOCAL_RERANK_PASSES=2
LOCAL_RERANK_BATCH_SIZE=8
LOCAL_RERANK_WINDOW_CHARS=1200
# 仅 API：每次问答最多发送的新段落数量及累计原文字数；0 表示不发送新段落。
# 多条查询先合并去重，重排分数缓存 7 天；缓存命中不占发送预算。
RERANK_MAX_DOCUMENTS=128
RERANK_MAX_CHARS=200000

# 留空使用持久化本地 Qdrant。较大书库推荐通过 Docker 启动服务：
# docker compose up -d，然后设置 QDRANT_URL=http://localhost:6333。
QDRANT_URL=
QDRANT_API_KEY=
# 自动优先使用可用 NVIDIA GPU；没有 CUDA 时使用 CPU。
LOCAL_DEVICE=auto
